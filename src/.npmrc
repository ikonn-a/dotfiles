# ~/.npmrc — читается npm всегда, в любой оболочке и в IDE.
#
# Глобальные пакеты ставятся в ~/.local, а не в /usr/local (он принадлежит root,
# из-за чего раньше требовался sudo npm install -g).
prefix=${HOME}/.local
cache=${HOME}/.local/share/npm-cache
fund=false
audit=false
update-notifier=false
