# Алиасы. Всё с проверкой наличия — работает на голой системе.

# Безопасность и мелочи
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -v'
alias mkd='mkdir -pv'
alias diff='diff --color=auto'

# ls / дерево
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first'
  alias ll='eza -l --group-directories-first --git'
  alias la='eza -la --group-directories-first --git'
  alias lt='eza --tree --level=2'
elif command -v ls >/dev/null 2>&1; then
  if [ "$(uname -s)" = Darwin ]; then
    alias ls='ls -G'
  else
    alias ls='ls --color=auto'
  fi
  alias ll='ls -l'
  alias la='ls -la'
fi

# cat
if command -v batcat >/dev/null 2>&1; then
  alias cat='batcat'
elif command -v bat >/dev/null 2>&1; then
  alias cat='bat'
fi

# grep / find
command -v rg >/dev/null 2>&1 && alias grep='rg' && alias rgf='rg --files'

# git
alias gs='git status -sb'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate -20'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gu='git pull --ff-only'

# прочее
command -v jq >/dev/null 2>&1 && alias jqc='jq -C'
alias ports='lsof -nP -iTCP -sTCP:LISTEN'
alias path='echo $PATH | tr ":" "\n"'
