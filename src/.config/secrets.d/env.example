# Шаблон секретов и адресов. Копируется в secrets.env командой `make secrets`.
# secrets.env подключается из .zshrc; в репозиторий не попадает.
#
# Формат: export NAME=value
# Пустые значения оставляйте закомментированными — агенты увидят пустую строку.

# --- LLM-провайдеры ---
# OpenAI-совместимый шлюз. Эти имена понимают openai-SDK и большинство
# клиентов без дополнительной настройки.
# export OPENAI_BASE_URL="https://llm-gateway.example.net/v1"
# export OPENAI_API_KEY=""
#
# Несколько шлюзов одновременно — заводите пары с префиксом:
# export TEAM_BASE_URL="https://llm-gateway.example.net/v1"
# export TEAM_API_KEY=""
# export PERSONAL_BASE_URL="https://api.openai.com/v1"
# export PERSONAL_API_KEY=""

# --- claude-code-router (локальный шлюз) ---
# export CCR_GATEWAY_URL="http://127.0.0.1:3456"
# export CCR_MANAGEMENT_URL="http://127.0.0.1:3458"

# --- Atlassian ---
# export JIRA_URL="https://jira.example.net"
# export JIRA_PERSONAL_TOKEN=""
# export CONFLUENCE_URL="https://confluence.example.net"
# export CONFLUENCE_PERSONAL_TOKEN=""

# --- Bitbucket Server ---
# export BITBUCKET_BASE_URL="https://git.example.net/"
# export BITBUCKET_USERNAME=""
# export BITBUCKET_TOKEN=""

# --- Context7 (документация) ---
# export CONTEXT7_API_KEY=""

# --- служебное ---
# export NODE_EXTRA_CA_CERTS="$HOME/st-ca-root.pem"
# export NODE_TLS_REJECT_UNAUTHORIZED="0"   # только для внутренних self-signed сервисов
